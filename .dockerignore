# Keep the build context small for the multi-stage Docker build.
# The build context is the nexus repo root.

# Heavy generated artefacts
.git/
.codegraph/
.groundwork/
.scratch/
.claude/

# Pre-compiled host binaries at repo root (not part of the Go source)
nexus
nexus-agent
buildorca
cli.test

# Example scratch dirs (allow virtiofsd — only host-staged binary needed)
examples/nexus-in-docker/stage/
!examples/nexus-in-docker/stage/virtiofsd
examples/nexus-in-docker/ws/
examples/nexus-in-docker/boottest/

# Go test / build cache
/bin/

# Editor / OS cruft
.DS_Store
*.swp

# VM disk images
*.ext4
*.img

# Docs build artefacts
docs/site/node_modules

# Allow everything else (cmd/, internal/, go.mod, go.sum, images/, proto/, plugins/, third_party/, …)
